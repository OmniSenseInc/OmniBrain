+        # OmniSense: WhatsApp admin access is pinned to exactly three identities.
+        # Consultation is handled by pre-dispatch; pairing/group/global grants are not admin roles.
+        if source.platform == Platform.WHATSAPP:
+            try:
+                from gateway.omnisense_policy import whatsapp_admin_authorized
+                return whatsapp_admin_authorized(source)
+            except Exception:
+                return False
+
